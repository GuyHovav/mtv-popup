# Copy this file to server/.env and fill in your keys.
# Primary provider — get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Fallback provider, used only if Gemini fails outright (quota/network/blocked
# response) — get a key at https://platform.openai.com/api-keys. Optional:
# if unset, a Gemini failure skips straight to the generic hardcoded facts.
OPENAI_API_KEY=

# Optional — adds real song metadata (writer/producer credits, sample and
# interpolation relationships, curated "about" text) to the prompt. Get a
# free Client Access Token by registering an API client at
# https://genius.com/api-clients (no OAuth flow needed). If unset, fact
# generation proceeds exactly as before, without Genius context.
GENIUS_ACCESS_TOKEN=

# Optional — powers the Suggested Videos row (other videos from the same
# channel/artist as the one playing). Get a key at
# https://console.cloud.google.com/apis/credentials (enable "YouTube Data
# API v3" on the project first). If unset, the app works exactly as before;
# the suggestions section just doesn't appear.
YOUTUBE_API_KEY=

# Optional — defaults to 3001
PORT=3001
